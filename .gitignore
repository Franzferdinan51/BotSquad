# Logs (regenerated on every run)
logs/
*.log

# Runtime state (regenerated by Watcher)
state/current.json
state/issues.json
state/executor_cooldowns.json

# Audit trail (keep it local, not in repo — these are operational records)
decisions/

# Skills (each agent writes here, may contain sensitive paths)
skills/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/

# Virtual envs
.venv/
venv/
env/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local config overrides (keep config.yaml tracked, but allow local-overrides.yaml)
# config.local.yaml

# Secrets (NEVER commit)
.env
*.pem
*.key
secrets/
